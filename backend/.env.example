# 数据库连接(本地开发用; docker compose 环境下 DATABASE_URL 由 compose 注入, 无需改此项)
DATABASE_URL=postgresql+asyncpg://agent:agent123@127.0.0.1:5432/agent_db

# OpenAI 兼容的模型接口
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# JWT 签名密钥, 生产环境请用随机字符串
JWT_SECRET=change-me

# 可选: 网络搜索工具(不填则不可用)
# WEB_SEARCH_API_KEY=tvly-xxx

# 可选: 模型高级配置(不填使用默认值)
# LLM_PROVIDER=openai
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2

# 可选: JWT 配置
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=7

# 可选: 网络搜索服务商与接口地址
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_BASE_URL=https://api.tavily.com/search

# 可选: 日志
# LOG_LEVEL=INFO
# DATABASE_ECHO=false

# 可选: 运维与诊断
# 置 true 时未捕获异常的响应会附带完整的异常类型和堆栈信息, 发布时应置为 false
# DEBUG_ERROR_DETAIL=false

# 深度体检 /api/health/deep: 需要已登录用户, 结果按 TTL 复用, 同一时刻最多一次真实执行
# HEALTH_DEEP_ENABLED=true
# 通过结果的复用秒数, 每个窗口最多触发一次真实模型调用
# HEALTH_DEEP_CACHE_TTL=60.0
# 降级结果的复用秒数, 应远小于上面的值, 避免故障恢复后被长时间掩盖
# HEALTH_DEEP_FAILURE_TTL=5.0
# 模型生成探针的超时秒数, 该探针会发起一次真实模型调用并产生费用
# HEALTH_DEEP_MODEL_TIMEOUT=5.0

# 受限工作区: read_file / write_file / run_shell 只能读写此目录, 不填则这三个工具全部拒绝执行
WORKSPACE_ROOT=/absolute/path/to/your/workspace
# WORKSPACE_MAX_READ_BYTES=2097152
# WORKSPACE_MAX_WRITE_BYTES=4194304
# 工作区内仍然拒绝访问的通配模式, 逗号分隔, 同时匹配相对路径与文件基名
# WORKSPACE_DENY_PATTERNS=.env,.env.*,.git,.git/*,*.pem,*.key,id_rsa,id_ed25519
# 额外放行给工具子进程的环境变量名, 逗号分隔; 本项目配置项无论如何都不会透传
# WORKSPACE_ENV_ALLOW=NO_COLOR,JAVA_HOME

# 出站网络策略: http_get 的目标地址受此约束, 默认只放行公网地址与 80/443 端口
# NETWORK_ENABLED=true
# NETWORK_ALLOWED_PORTS=80,443
# 命中放行名单的主机可访问内网地址, 逗号分隔; 支持 *.example.com 形式(只匹配子域)
# NETWORK_HOST_ALLOW=
# NETWORK_HOST_DENY=
# 本地开发需要访问内网服务时置 true, 生产必须为 false
# NETWORK_ALLOW_PRIVATE=false
# NETWORK_MAX_REDIRECTS=3
# NETWORK_MAX_RESPONSE_BYTES=2097152
# 同时约束 TCP 连接与 TLS 握手, 不要低于 10s
# NETWORK_CONNECT_TIMEOUT=10.0
# NETWORK_READ_TIMEOUT=15.0

# 可选: 上下文压缩策略
# COMPACT_ENABLED=true
# COMPACT_TRIGGER_FRACTION=0.75
# COMPACT_WARN_FRACTION=0.6
# COMPACT_KEEP_FRACTION=0.3
# COMPACT_MODEL_MAX_TOKENS=
# COMPACT_DEFAULT_MAX_TOKENS=64000
